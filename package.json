{
  "name": "house-3d",
  "private": true,
  "version": "0.5.22",
  "type": "module",
  "description": "3D 房屋可视化：TypeScript + Vite 结构化工程，支持编译为单一 HTML 发布",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build-all.mjs offline",
    "build:cdn": "tsc --noEmit && node scripts/build-all.mjs cdn",
    "build:all": "tsc --noEmit && node scripts/build-all.mjs",
    "preview": "vite preview",
    "gen:cad": "esbuild scripts/genHouseCad.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/genHouseCad.mjs && node node_modules/.cache/genHouseCad.mjs",
    "gen:dxf": "esbuild scripts/genHouseDxf.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/genHouseDxf.mjs && node node_modules/.cache/genHouseDxf.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "metaverse-sky": "^0.2.1",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-singlefile": "^2.0.2"
  }
}
